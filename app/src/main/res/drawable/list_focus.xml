<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    
    <!-- Голубоватая полупрозрачная заливка внутри выделения. 
         (4D в начале означает прозрачность ~30%. Если родная заливка 
         была чуть другого оттенка, вы можете скорректировать здесь цвет) -->
    <solid android:color="#4D5C8EA6" /> 
    
    <!-- Новая одинарная обводка нужного цвета -->
    <stroke
        android:width="2dp"
        android:color="#5C8EA6" />
        
    <!-- Небольшое скругление самой рамки выделения для эстетики -->
    <corners android:radius="12dp" /> 
    
</shape>