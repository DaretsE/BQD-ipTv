<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Состояние: Пункт ВЫДЕЛЕН пультом -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- Голубоватая полупрозрачная заливка -->
            <solid android:color="#4D5C8EA6" /> 
            <!-- Одинарная обводка нужного цвета -->
            <stroke android:width="2dp" android:color="#5C8EA6" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- 2. Состояние: Кнопка НАЖАТА -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#665C8EA6" /> 
            <stroke android:width="2dp" android:color="#5C8EA6" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- 3. ОБЫЧНОЕ состояние (когда фокуса нет) -->
    <!-- Делаем фон полностью прозрачным, чтобы обводка исчезала -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>