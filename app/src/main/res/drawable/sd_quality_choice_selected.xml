<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#418FA2" android:endColor="#2B7184" android:angle="315" />
            <stroke android:width="2dp" android:color="#B2F2F8" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#347B8D" android:endColor="#276678" android:angle="315" />
            <stroke android:width="1dp" android:color="@color/accent2" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
